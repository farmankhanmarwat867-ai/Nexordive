# Server Configuration
NODE_ENV=development
PORT=5000

# MongoDB Connection (Local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/nexordive

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT Secrets (use 32+ random characters in production)
JWT_ACCESS_SECRET=replace_with_a_strong_32_plus_char_access_secret_key
JWT_REFRESH_SECRET=replace_with_a_strong_32_plus_char_refresh_secret_key
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookie Domain (optional, leave blank on localhost)
COOKIE_DOMAIN=

# Optional Seed Admin Credentials (used only by `npm run seed` when no admin exists yet)
SEED_ADMIN_NAME=Website Manager
SEED_ADMIN_EMAIL=manager@nexordive.com
SEED_ADMIN_PASSWORD=ChangeMe123!

# Optional SMTP Configuration for Lead Email Alerts (leave blank to skip email sending in dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=NexorDive <no-reply@nexordive.com>
LEADS_NOTIFY_EMAIL=
